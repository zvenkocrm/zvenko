# Переменные локальной среды. Настоящий .env создаёт `pnpm dev:up` со случайными значениями.
# Значения ниже — только описание формата, не используйте их.
POSTGRES_PASSWORD=change-me
VALKEY_PASSWORD=change-me
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
APP_DB_PASSWORD=change-me
IDENTITY_DB_PASSWORD=change-me
# API — ролью приложения (RLS действует), миграции — ролью-владельцем схемы.
DATABASE_URL=postgres://zvenko_app:change-me@127.0.0.1:5432/zvenko
MIGRATION_DATABASE_URL=postgres://zvenko:change-me@127.0.0.1:5432/zvenko
# Модуль входа — своей ролью: пароли и сессии отдельно от данных компаний.
IDENTITY_DATABASE_URL=postgres://zvenko_identity:change-me@127.0.0.1:5432/zvenko
# Не короче 32 символов; в продакшене — из хранилища секретов.
AUTH_SECRET=change-me-change-me-change-me-change-me
# Адреса, с которых открывают приложение. В продакшене — https://*.zvenko.ru
AUTH_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
