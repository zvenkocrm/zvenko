          "value": "\"audit_log\".\"result\" in ('success', 'failure')"
        },
        "audit_log_object": {
          "name": "audit_log_object",
          "value": "(\"audit_log\".\"object_type\" is null) = (\"audit_log\".\"object_id\" is null)\n        and (\"audit_log\".\"object_type\" is null or \"audit_log\".\"object_type\" ~ '^[a-z][a-z_]{0,31}$')"
        },
        "audit_log_ip": {
          "name": "audit_log_ip",
          "value": "masklen(\"audit_log\".\"ip\") = case family(\"audit_log\".\"ip\") when 4 then 32 else 128 end"
        },
        "audit_log_user_agent": {
          "name": "audit_log_user_agent",
          "value": "char_length(\"audit_log\".\"user_agent\") <= 512"
        },
        "audit_log_request_id": {
          "name": "audit_log_request_id",
          "value": "\"audit_log\".\"request_id\" ~ '^[A-Za-z0-9-]{8,64}$'"
        },
        "audit_log_details": {
          "name": "audit_log_details",
          "value": "jsonb_typeof(\"audit_log\".\"details\") = 'object' and octet_length(\"audit_log\".\"details\"::text) <= 4096"
        },
        "audit_log_hash": {
          "name": "audit_log_hash",
          "value": "octet_length(\"audit_log\".\"prev_hash\") = 32 and octet_length(\"audit_log\".\"hash\") = 32"
        }
