        "audit_log_actor": {
          "name": "audit_log_actor",
          "value": "(\"audit_log\".\"actor_type\" in ('user', 'support') and \"audit_log\".\"actor_id\" is not null)\n        or (\"audit_log\".\"actor_type\" in ('system', 'anonymous') and \"audit_log\".\"actor_id\" is null)"
