# --- Зависимости и сборка ---
node_modules/
dist/
build/
coverage/
.turbo/
*.tsbuildinfo

# --- Секреты: никогда не коммитим ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
.dev/

# --- Состояние инфраструктуры (содержит секреты) ---
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example

# --- Логи ---
*.log

# --- Локальные переопределения ---
mise.local.toml
.mise.local.toml
.claude/settings.local.json

# --- Файлы, которые создают инструменты сами ---
# Turborepo новее 2.11.4 пишет AGENTS.md с инструкциями для ИИ-агентов. Наши правила для
# агентов — в CLAUDE.md; при обновлении turbo вернуть в turbo.json "agentGuidance": false.
AGENTS.md

# --- IDE и ОС ---
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
desktop.ini
